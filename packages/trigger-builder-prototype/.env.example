# Mapbox public token for the interactive geography map.
# Copy this file to .env.local and fill in a valid Mapbox public token.
# The token must be URL-restricted for the relevant local or deployed origin and
# have access to the IFRC style/tilesets plus Mapbox Search. If it is missing or
# rejected, geography selection is blocked; there is no offline country fallback.
# In Docker / Cloud Run, MAPBOX_TOKEN is injected at runtime by 40-env-config.sh.
VITE_MAPBOX_TOKEN=

# Backend API base URL for local development.
# Point this at the trigger-builder Django backend when running it locally.
# Example: VITE_API_BASE_URL=http://localhost:8000
# When this value is empty the Generate button uses a simulated local fallback.
# In Docker / Cloud Run, API_BASE_URL is injected at runtime via 40-env-config.sh.
VITE_API_BASE_URL=

# GO API base URL used by the structured country selector.
# In Docker / Cloud Run, GO_API_BASE_URL is injected at runtime. The production
# GO API is used by default when this value is empty.
VITE_GO_API_BASE_URL=https://goadmin.ifrc.org/api/v2
