# vim: filetype=nginx

server {
    listen ${PORT};
    server_name _;

    gzip on;
    gzip_comp_level 4;

    gzip_types text/plain text/css application/json
        application/x-javascript text/xml application/xml
        application/xml+rss text/javascript image/svg+xml;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' https://goadmin.ifrc.org https://*.ifrc.org https://*.a.run.app https://*.mapbox.com; img-src 'self' data: blob: https://*.mapbox.com; font-src 'self' data: https://*.mapbox.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header X-Frame-Options "DENY" always;
    set $prototype_cache_control "no-store";
    if ($uri ~* "^/assets/.*\.(?:css|js|svg|png|jpg|jpeg|gif|webp|woff2?)$") {
        set $prototype_cache_control "public, max-age=31536000, immutable";
    }
    add_header Cache-Control $prototype_cache_control always;

    location = / {
        root /usr/share/nginx/html;
        try_files /index.html =404;
    }

    location = /index.html {
        root /usr/share/nginx/html;
    }

    location = /env-config.js {
        root /usr/share/nginx/html;
    }

    location ~* \.(?:css|js|svg|png|jpg|jpeg|gif|webp|woff2?)$ {
        root /usr/share/nginx/html;
        try_files $uri =404;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri /index.html;
    }
}
