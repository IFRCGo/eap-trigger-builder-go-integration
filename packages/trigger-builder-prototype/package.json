{
    "name": "@ifrc-go/trigger-builder-prototype",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/IFRCGo/go-web-app.git",
        "directory": "packages/trigger-builder-prototype"
    },
    "scripts": {
        "sync:inputs": "node scripts/sync-inputs.mjs",
        "predev": "corepack pnpm --dir ../.. -F @ifrc-go/ui build && node scripts/sync-inputs.mjs",
        "dev": "vite",
        "prebuild": "corepack pnpm --dir ../.. -F @ifrc-go/ui build && node scripts/sync-inputs.mjs",
        "build": "vite build",
        "pretypecheck": "corepack pnpm --dir ../.. -F @ifrc-go/ui build && node scripts/sync-inputs.mjs",
        "typecheck": "tsc --noEmit",
        "lint:js": "eslint src",
        "preview": "vite preview",
        "test": "vitest run"
    },
    "dependencies": {
        "@ifrc-go/icons": "^2.0.1",
        "@ifrc-go/ui": "workspace:^",
        "@mapbox/search-js-core": "1.5.1",
        "mapbox-gl": "^1.13.3",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.4",
        "@types/mapbox-gl": "^1.13.10",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react-swc": "^4.0.0",
        "eslint": "^9.39.4",
        "eslint-plugin-react-hooks": "^7.0.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "happy-dom": "^20.0.0",
        "playwright": "^1.60.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.58.0",
        "vite": "^6.0.0",
        "vitest": "^4.0.0"
    }
}
